{
  "name": "pdf-local",
  "version": "2.4.0-beta.7",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "python3 tests/fixtures/security/generate.py",
    "test": "node --test tests/*.test.mjs",
    "build:signing": "esbuild signing-src/sign.js --bundle --platform=browser --format=esm --minify --define:process=undefined --inject:signing-src/buffer-shim.js --alias:pdf-lib=./dist/vendor/pdf-lib.js --outfile=dist/vendor/signing.js",
    "build:icons": "node scripts/render-icons.mjs",
    "build": "npm run build:client && node scripts/build-hosting.mjs",
    "package": "python3 scripts/package.py",
    "build:client": "node scripts/vendor.mjs && npm run build:signing && npm run build:icons"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@signpdf/placeholder-pdf-lib": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "jszip": "3.10.1",
    "tesseract.js": "7.0.0",
    "node-forge": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.6.205",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "tesseract.js-core": "7.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "license": "MIT",
  "description": "Herramientas PDF locales en espa\u00f1ol para Windows, macOS, Android e iOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/joinsnipe/PDF.git"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
